# Used in testing
NUTRIENT_DWS_API_KEY=your-nutrient-dws-api-key
# Required for data_extractor only when NUTRIENT_DWS_API_KEY is set (static key mode) — Data Extraction
# is a separate product/tenant, so the Processor key above cannot also authenticate it. Not needed under OAuth.
NUTRIENT_DWS_EXTRACT_API_KEY=your-nutrient-dws-extract-api-key
