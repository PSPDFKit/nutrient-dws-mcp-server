# Used in testing
NUTRIENT_DWS_API_KEY=your-nutrient-dws-api-key
# Required for parse_document / extract_fields when NUTRIENT_DWS_API_KEY is set (static key mode) — Data
# Extraction is a separate product/tenant, so the Processor key above cannot also authenticate it. Not needed
# under OAuth. Can also be set alone, with no NUTRIENT_DWS_API_KEY, to run the server in extraction-only mode.
NUTRIENT_DWS_EXTRACT_API_KEY=your-nutrient-dws-extract-api-key
